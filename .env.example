# ==============================================================================
# GABINETE DIGITAL 360° — TEMPLATE DE VARIÁVEIS DE AMBIENTE (PRODUÇÃO & STAGING)
# AVISO CRÍTICO: NUNCA COMMITAR ARQUIVOS .env COM CHAVES REAIS NO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPERATIONAL PLANE / CLIENT PORTAL (apps/client — Porta 3000)
# Destinado ao Gabinete Parlamentar, Vereadores, Servidores e Cidadãos
# ------------------------------------------------------------------------------
# URL pública do painel do cliente
NEXT_PUBLIC_APP_URL=https://app.gabinete360.com.br

# Conexão com o banco do Operational Plane
NEXT_PUBLIC_SUPABASE_URL=https://efughosfkbirbjaqwyya.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ftto26963Xzb_0loxD0p2w_9PPeleUz

# Flag de Demonstração (OBRIGATÓRIO 'false' em Produção; 'true' apenas em Staging/Homologação)
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. CONTROL PLANE / MASTER PORTAL (apps/master — Porta 3001)
# Destinado exclusivamente à equipe de Engenharia e Operações da DM IA Studio
# ------------------------------------------------------------------------------
# URL pública do painel master administrativo
NEXT_PUBLIC_MASTER_APP_URL=https://master.gabinete360.com.br

# Instância Supabase do Control Plane (Recomendado projeto Supabase separado do Operational Plane)
NEXT_PUBLIC_MASTER_SUPABASE_URL=https://efughosfkbirbjaqwyya.supabase.co
NEXT_PUBLIC_MASTER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ftto26963Xzb_0loxD0p2w_9PPeleUz

# ------------------------------------------------------------------------------
# 3. SEGREDOS EXCLUSIVOS DO SERVIDOR (SERVER-SIDE ONLY)
# NUNCA utilizar o prefixo NEXT_PUBLIC_ nestas variáveis!
# Injetar diretamente no painel de segredos da Vercel / Cloudflare / Fly.io
# ------------------------------------------------------------------------------
# Chave mestra de serviço do Supabase (Apenas apps/master e rotas autenticadas do servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Chave de API Google Gemini (Assistente Legislativo e Classificação de Demandas)
GEMINI_API_KEY=

# Chave secreta interna para validação de JWTs administrativos Master
MASTER_ADMIN_JWT_SECRET=

# WhatsApp Microservice (Client App Server-Side)
WHATSAPP_API_URL=
WHATSAPP_API_GLOBAL_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
