{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "apps/client",
      "framework": "nextjs"
    },
    "master": {
      "root": "apps/master",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/master/(.*)",
      "destination": {
        "service": "master"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
